# Copy to .env, set mode 0600, and generate a fresh token of at least 32 characters.
NL2SH_A2A_TOKEN=
NL2SH_DEVICE_SERIAL=192.168.1.50:5555
NL2SH_DEVICE_BINARY=/data/local/tmp/nl2sh
NL2SH_DEVICE_CONFIG=/data/local/tmp/config.toml

# Replace both URL and bind address when Hermes connects from another host.
NL2SH_GATEWAY_URL=http://127.0.0.1:8765
NL2SH_GATEWAY_BIND=127.0.0.1
NL2SH_GATEWAY_PORT=8765

# This Compose example opts into HTTP inside the container; keep the published
# port on loopback unless the gateway host is on a trusted private network.
NL2SH_A2A_ALLOW_INSECURE_HTTP=1
